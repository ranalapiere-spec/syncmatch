<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>SYNC Match - Learn, Share, Grow</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-main: #FAF7F4;
            --card-bg: #FFFFFF;
            --text-main: #46372E;
            --text-sub: #7A6A5E;
            --accent: #A3795C;
            --border-color: #EFECE6;
            --nav-bg: rgba(250, 247, 244, 0.95);
            --shadow: 0 10px 30px rgba(70, 55, 46, 0.05);
        }

        [data-theme="dark"] {
            --bg-main: #1A1614;
            --card-bg: #2C2623;
            --text-main: #FAF7F4;
            --text-sub: #D1C5BD;
            --accent: #C49A7E;
            --border-color: #3D3430;
            --nav-bg: rgba(26, 22, 20, 0.95);
            --shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: background 0.3s ease, color 0.3s ease;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            min-height: 100vh;
            padding-bottom: 90px;
        }

        .app-container {
            width: 100%;
            max-width: 480px;
            background: var(--bg-main);
            min-height: 100vh;
            position: relative;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 20px 10px 20px;
        }

        .logo-area h1 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-style: italic;
            font-weight: 600;
            color: var(--text-main);
        }

        .header-icons {
            display: flex;
            gap: 12px;
        }

        .icon-btn {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-main);
            cursor: pointer;
            box-shadow: var(--shadow);
        }

        .content-area {
            padding: 10px 20px;
            flex: 1;
            overflow-y: auto;
        }

        .view-section {
            display: none;
        }

        .view-section.active {
            display: block;
        }

        /* UME Dashboard Widgets */
        .welcome-card {
            background: var(--card-bg);
            border-radius: 24px;
            padding: 20px;
            margin-bottom: 16px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .welcome-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.5rem;
            font-weight: bold;
            overflow: hidden;
        }

        .welcome-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .welcome-text h2 {
            font-size: 1.1rem;
            font-weight: 700;
        }

        .welcome-text p {
            font-size: 0.82rem;
            color: var(--text-sub);
            margin-top: 3px;
            font-style: italic;
        }

        .grid-widgets {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }

        .widget-card {
            background: var(--card-bg);
            border-radius: 24px;
            padding: 18px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
        }

        .widget-full {
            grid-column: span 2;
        }

        /* Bottom Nav */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            width: 100%;
            max-width: 480px;
            background: var(--nav-bg);
            backdrop-filter: blur(10px);
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-around;
            padding: 12px 0;
            z-index: 1000;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--text-sub);
            text-decoration: none;
            font-size: 0.75rem;
            gap: 4px;
            cursor: pointer;
        }

        .nav-item.active {
            color: var(--text-main);
            font-weight: 600;
        }

        .nav-item i {
            font-size: 1.2rem;
        }

        /* Auth Screen dengan Logo Jam / Kompas Estetik */
        #auth-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--bg-main);
            z-index: 2000;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 30px;
            text-align: center;
        }

        .auth-logo-badge {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: var(--card-bg);
            border: 2px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
            color: var(--accent);
            box-shadow: var(--shadow);
            margin-bottom: 20px;
        }

        .btn-primary {
            background: var(--text-main);
            color: var(--bg-main);
            border: none;
            padding: 14px 28px;
            border-radius: 30px;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
            max-width: 300px;
            margin-top: 20px;
            box-shadow: var(--shadow);
        }
    </style>
</head>
<body>

    <!-- Layar Autentikasi dengan Logo Jam Estetik -->
    <div id="auth-screen">
        <div class="auth-logo-badge">
            <i class="fa-solid fa-compass-drafting"></i>
        </div>
        <div style="font-family: 'Playfair Display'; font-size: 2.2rem; font-style: italic; margin-bottom: 5px;">SYNC Match</div>
        <p style="color: var(--text-sub); margin-bottom: 25px; font-size: 0.88rem;">Learn • Share • Grow</p>
        <button class="btn-primary" onclick="handleGoogleLogin()"><i class="fa-brands fa-google" style="margin-right: 8px;"></i> Masuk dengan Google</button>
    </div>

    <div class="app-container">
        <!-- Header Utama -->
        <header>
            <div class="logo-area">
                <h1>SYNC Match</h1>
            </div>
            <div class="header-icons">
                <button class="icon-btn" onclick="toggleTheme()"><i class="fa-solid fa-moon" id="theme-icon"></i></button>
                <button class="icon-btn"><i class="fa-regular fa-bell"></i></button>
            </div>
        </header>

        <!-- Area Konten Dinamis -->
        <div class="content-area">
            
            <!-- Tab UME (Personal Sanctuary Dashboard) -->
            <section id="view-ume" class="view-section active">
                <div class="welcome-card">
                    <div class="welcome-avatar" id="user-avatar-container">
                        <span id="user-avatar-initial">J</span>
                    </div>
                    <div class="welcome-text">
                        <h2 id="user-display-name">Halo, Jaesslyn ✨</h2>
                        <p>"Keep going, better days are coming."</p>
                    </div>
                </div>

                <div class="grid-widgets">
                    <div class="widget-card">
                        <p style="font-size: 0.75rem; color: var(--text-sub); font-weight: 600;">HARI INI</p>
                        <h3 style="font-size: 1.1rem; margin-top: 6px;" id="current-date-text">18 Nov</h3>
                        <p style="font-size: 0.78rem; color: var(--accent); margin-top: 2px;" id="current-day-text">Selasa</p>
                    </div>
                    <div class="widget-card">
                        <p style="font-size: 0.75rem; color: var(--text-sub); font-weight: 600;">SUASANA HATI</p>
                        <h3 style="font-size: 1rem; margin-top: 6px;">🌸 Tenang</h3>
                        <p style="font-size: 0.78rem; color: var(--text-sub); margin-top: 2px;">Fokus Belajar</p>
                    </div>
                    <div class="widget-card widget-full">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <span style="font-size: 0.78rem; color: var(--text-sub); font-weight: 600;"><i class="fa-solid fa-music"></i> UME Music Sanctuary</span>
                            <span style="font-size: 0.72rem; color: var(--accent);">Audius Stream</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <h4 style="font-size: 0.95rem;">Lofi Study Beats</h4>
                                <p style="font-size: 0.75rem; color: var(--text-sub);">Cozy Vibe</p>
                            </div>
                            <button class="icon-btn" style="width: 38px; height: 38px;"><i class="fa-solid fa-play"></i></button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Tab Komunitas / Discover -->
            <section id="view-discover" class="view-section">
                <h2 style="font-size: 1.2rem; margin-bottom: 15px;">Eksplorasi Partner</h2>
                <p style="color: var(--text-sub); font-size: 0.9rem;">Temukan partner belajar asli untuk berkolaborasi dan meningkatkan skill bersama.</p>
            </section>

            <!-- Tab Chat & Group -->
            <section id="view-chat" class="view-section">
                <h2 style="font-size: 1.2rem; margin-bottom: 15px;">Pesan & Grup</h2>
                <p style="color: var(--text-sub); font-size: 0.9rem;">Belum ada pesan masuk.</p>
            </section>

            <!-- Tab Profil -->
            <section id="view-profile" class="view-section">
                <h2 style="font-size: 1.2rem; margin-bottom: 15px;">Profil Saya</h2>
                <p style="color: var(--text-sub); font-size: 0.9rem;" id="profile-email-label">Email: -</p>
            </section>

        </div>

        <!-- Navigasi Bawah -->
        <nav class="bottom-nav">
            <div class="nav-item active" onclick="switchTab('ume', this)">
                <i class="fa-solid fa-house"></i>
                <span>Home</span>
            </div>
            <div class="nav-item" onclick="switchTab('discover', this)">
                <i class="fa-solid fa-compass"></i>
                <span>Discover</span>
            </div>
            <div class="nav-item" onclick="switchTab('chat', this)">
                <i class="fa-regular fa-comment-dots"></i>
                <span>Chat</span>
            </div>
            <div class="nav-item" onclick="switchTab('profile', this)">
                <i class="fa-regular fa-user"></i>
                <span>Profil</span>
            </div>
        </nav>
    </div>

    <!-- Firebase SDK & Script Utama -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getAuth, GoogleAuthProvider, signInWithPopup, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";

        const firebaseConfig = {
          apiKey: "AIzaSyC5V6OBw_pVdUZO-01HloF7u_OOGjvJb3I",
          authDomain: "syncmatcteen.firebaseapp.com",
          databaseURL: "https://syncmatcteen-default-rtdb.asia-southeast1.firebasedatabase.app",
          projectId: "syncmatcteen",
          storageBucket: "syncmatcteen.firebasestorage.app",
          messagingSenderId: "880276728619",
          appId: "1:880276728619:web:9845c02854697a0db5336e",
          measurementId: "G-JRGVRFD18P"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const provider = new GoogleAuthProvider();

        window.handleGoogleLogin = function() {
            signInWithPopup(auth, provider).then((result) => {
                console.log("Login Berhasil:", result.user);
            }).catch((error) => {
                alert("Gagal Masuk: " + error.message);
            });
        };

        onAuthStateChanged(auth, (user) => {
            if (user) {
                document.getElementById('auth-screen').style.display = 'none';
                document.getElementById('user-display-name').innerText = `Halo, ${user.displayName || 'Jaesslyn'} ✨`;
                
                if (user.photoURL) {
                    document.getElementById('user-avatar-container').innerHTML = `<img src="${user.photoURL}" alt="Avatar">`;
                } else {
                    document.getElementById('user-avatar-initial').innerText = (user.displayName || 'J').charAt(0).toUpperCase();
                }
                document.getElementById('profile-email-label').innerText = `Email: ${user.email}`;
            } else {
                document.getElementById('auth-screen').style.display = 'flex';
            }
        });
    </script>

    <script>
        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('theme-icon');
            if (html.getAttribute('data-theme') === 'dark') {
                html.removeAttribute('data-theme');
                icon.className = 'fa-solid fa-moon';
                localStorage.setItem('theme', 'light');
            } else {
                html.setAttribute('data-theme', 'dark');
                icon.className = 'fa-solid fa-sun';
                localStorage.setItem('theme', 'dark');
            }
        }

        if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
            document.getElementById('theme-icon').className = 'fa-solid fa-sun';
        }

        function switchTab(tabId, element) {
            document.querySelectorAll('.view-section').forEach(sec => sec.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            
            document.getElementById('view-' + tabId).classList.add('active');
            element.classList.add('active');
        }
    </script>
</body>
</html>
